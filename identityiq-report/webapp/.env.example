# Shared secret the IdentityIQ rule presents as "Authorization: Bearer ...".
# Generate one, e.g.: openssl rand -hex 32
INGEST_TOKEN=

# Maximum accepted report size in megabytes.
MAX_UPLOAD_MB=200

# Port the app listens on (plain HTTP; put a TLS reverse proxy in front).
PORT=8080

# Where report CSVs are stored (the Dockerfile sets /data).
#DATA_DIR=/data
